{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edastack.dev/schemas/canonical-source-graph.schema.json",
  "title": "Canonical physical-pin source graph",
  "type": "object",
  "required": ["schema_version", "components", "ports", "nets"],
  "properties": {
    "schema_version": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference", "component_type", "properties"],
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "component_type": { "type": "string", "minLength": 1 },
          "properties": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "pin", "name", "net_id"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "pin": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "name": { "type": "string", "minLength": 1 },
          "net_id": { "type": "string", "pattern": "^N[0-9]{3,}$" }
        },
        "additionalProperties": false
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "names", "pins"],
        "properties": {
          "id": { "type": "string", "pattern": "^N[0-9]{3,}$" },
          "names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "pins": { "type": "array", "items": { "type": "string", "pattern": "^[^:]+:[1-9][0-9]*$" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
