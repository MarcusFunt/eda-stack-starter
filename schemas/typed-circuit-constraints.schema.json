{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edastack.dev/schemas/typed-circuit-constraints.schema.json",
  "title": "EDA Stack typed circuit constraints",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "target", "property", "operator", "value"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "kind": { "enum": ["electrical", "physical", "component"] },
          "target": {
            "oneOf": [
              { "type": "object", "required": ["type"], "properties": { "type": { "const": "board" } }, "additionalProperties": false },
              { "type": "object", "required": ["type", "reference"], "properties": { "type": { "const": "component" }, "reference": { "type": "string" } }, "additionalProperties": false },
              { "type": "object", "required": ["type", "reference", "pin_number"], "properties": { "type": { "const": "pin" }, "reference": { "type": "string" }, "pin_number": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
              { "type": "object", "required": ["type", "id"], "properties": { "type": { "const": "net" }, "id": { "type": "string" } }, "additionalProperties": false },
              { "type": "object", "required": ["type", "name"], "properties": { "type": { "const": "net" }, "name": { "type": "string" } }, "additionalProperties": false }
            ]
          },
          "property": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "minLength": 1 },
          "value": {},
          "hard": { "type": "boolean", "default": true },
          "source": {
            "type": "object",
            "required": ["path", "jsonPointer"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "jsonPointer": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
