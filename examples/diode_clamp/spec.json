{
  "schema_version": 1,
  "name": "diode_clamp",
  "netlist": "clamp.cir",
  "parameters": {"R": "1k"},
  "scenarios": [
    {"name": "nominal", "set": {}},
    {"name": "low_resistance", "set": {"R": "900"}},
    {"name": "high_resistance", "set": {"R": "1.1k"}}
  ],
  "analyses": ["tran 1u 4m"],
  "measurements": [
    {"id": "positive_peak", "directive": "meas tran positive_peak MAX v(out) FROM=1m TO=4m", "unit": "V", "min": 0.5, "max": 1.2, "description": "Clamped positive output voltage"},
    {"id": "negative_peak", "directive": "meas tran negative_peak MIN v(out) FROM=1m TO=4m", "unit": "V", "min": -5.01, "max": -4.0, "description": "Negative output swing"}
  ]
}
